{
  "name": "goletter/hyperf-cas",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "goletter",
      "email": "goletter@outlook.com"
    }
  ],
  "keywords": [
    "php",
    "hyperf",
    "cas",
    "sso",
    "hyperf-cas"
  ],
  "description": "hyperf CAS 单点登录扩展包（前后端分离）",
  "require": {
    "php": ">=8.1",
    "ext-simplexml": "*",
    "hyperf/config": "~3.1.0",
    "hyperf/context": "~3.1.0",
    "hyperf/di": "~3.1.0",
    "hyperf/event": "~3.1.0",
    "hyperf/guzzle": "~3.1.0",
    "hyperf/http-server": "~3.1.0",
    "hyperf/redis": "~3.1.0",
    "hyperf/support": "~3.1.0"
  },
  "autoload": {
    "psr-4": {
      "Goletter\\Cas\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit 1024M -l 0 ./src",
    "cs-fix": "php-cs-fixer fix $1"
  },
  "extra": {
    "hyperf": {
      "config": "Goletter\\Cas\\ConfigProvider"
    }
  }
}
